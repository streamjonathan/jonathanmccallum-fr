---
layout: layouts/base.njk
---
<article>
  <h1>{{ title }}</h1>
  {% if page.date %}
  <p class="meta"><time datetime="{{ page.date.toISOString() }}">{{ page.date.toISOString().slice(0, 10) }}</time></p>
  {% endif %}
  <p class="translation-note translation-note--top">J'espère vraiment que la traduction est bonne — elle a probablement quelques erreurs.</p>
  <div class="post-body">
  {{ content | safe }}
  </div>
</article>
{% include "get-involved.njk" %}
{% set prevPost = collections.publishedPosts | getPreviousCollectionItem(page) %}
{% set nextPost = collections.publishedPosts | getNextCollectionItem(page) %}
{% if prevPost or nextPost %}
<p class="post-nav__hint">{% if nextPost and prevPost %}Glissez vers la gauche pour le texte suivant · Glissez vers la droite pour le précédent{% elif nextPost %}Glissez vers la gauche pour le texte suivant{% else %}Glissez vers la droite pour le précédent{% endif %}</p>
<nav class="post-nav" aria-label="More writing">
  {% if prevPost %}<a class="post-nav__prev" href="{{ prevPost.url }}">← {{ prevPost.data.title }}</a>{% endif %}
  {% if nextPost %}<a class="post-nav__next" href="{{ nextPost.url }}">{{ nextPost.data.title }} →</a>{% endif %}
</nav>
{% endif %}
